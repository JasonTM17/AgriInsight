AGRIINSIGHT_ARTIFACTS=artifacts
AGRIINSIGHT_SEED=20260718
AGRIINSIGHT_AS_OF_DATE=2026-07-18

# Optional XLSX adapter. Leave unset unless the private artifact-tool runtime exists.
# AGRIINSIGHT_NODE_EXECUTABLE=C:\Program Files\nodejs\node.exe
# AGRIINSIGHT_NODE_MODULES=D:\path\to\artifact-tool\node_modules

# Optional PowerShell-session overrides for scripts/run-backend-tests.ps1.
# This file is documentation only; the wrapper does not auto-load .env files.
MAVEN_REPO_LOCAL=D:\AgriInsight\artifacts\_tmp\m2-repository
MAVEN_TEMP_DIR=D:\AgriInsight\artifacts\_tmp\java-tmp
MAVEN_USER_HOME=D:\AgriInsight\artifacts\_tmp\maven-user-home

# Guarded backend runner rejects these hidden Maven channels; keep them empty.
MAVEN_ARGS=
MAVEN_CONFIG=
MAVEN_PROJECTBASEDIR=

# Optional backend Compose profile. Copy to an ignored local environment file,
# then set unique secrets; blank values intentionally fail closed.
AGRIINSIGHT_POSTGRES_OPERATOR_PASSWORD=
AGRIINSIGHT_DB_MIGRATOR_PASSWORD=
AGRIINSIGHT_DB_RUNTIME_PASSWORD=
AGRIINSIGHT_DB_REALTIME_PASSWORD=
AGRIINSIGHT_OIDC_ISSUER_URI=
AGRIINSIGHT_OIDC_API_AUDIENCE=
AGRIINSIGHT_OIDC_INTERACTIVE_CLIENT_ID=
AGRIINSIGHT_POSTGRES_PORT=5432
AGRIINSIGHT_BACKEND_PORT=8080
AGRIINSIGHT_KAFKA_PORT=9094

# DeepSeek RAG assistant. Keep the real key only in ignored .env or a secret store.
AGRIINSIGHT_ASSISTANT_ENABLED=false
AGRIINSIGHT_LLM_PROVIDER=deepseek
AGRIINSIGHT_LLM_BASE_URL=https://api.deepseek.com
AGRIINSIGHT_LLM_MODEL=deepseek-v4-flash
AGRIINSIGHT_LLM_API_KEY=
AGRIINSIGHT_LLM_THINKING_ENABLED=false
AGRIINSIGHT_LLM_CONNECT_TIMEOUT_SECONDS=3
AGRIINSIGHT_LLM_READ_TIMEOUT_SECONDS=25
AGRIINSIGHT_ASSISTANT_MAX_QUERY_CHARS=1200
AGRIINSIGHT_ASSISTANT_MAX_HISTORY_TURNS=6
AGRIINSIGHT_ASSISTANT_MAX_EVIDENCE_ITEMS=8
AGRIINSIGHT_ASSISTANT_MAX_EVIDENCE_CHARS=12000
AGRIINSIGHT_ASSISTANT_MAX_OUTPUT_TOKENS=1200
AGRIINSIGHT_ASSISTANT_MAX_CONCURRENT_REQUESTS=8

# Optional internal analytics API. Paths are resolved by the process and the
# reconciliation report must be generated by the guarded demo bootstrap.
# AGRIINSIGHT_ANALYTICS_ARTIFACT_ROOT=artifacts/big-data
# AGRIINSIGHT_ANALYTICS_DEMO_TENANT_ID=20000000-0000-4000-8000-000000000001
# AGRIINSIGHT_ANALYTICS_RECONCILIATION_REPORT=_tmp/demo-bootstrap/reconciliation.json
# AGRIINSIGHT_ANALYTICS_SPRING_BASE_URL=http://127.0.0.1:8080
# AGRIINSIGHT_ANALYTICS_BIND_HOST=127.0.0.1
# AGRIINSIGHT_ANALYTICS_PORT=8081
