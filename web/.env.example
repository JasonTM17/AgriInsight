# Copy to web/.env.local for local development. Never commit real values.
AGRIINSIGHT_WEB_BASE_URL=https://localhost:3100
AGRIINSIGHT_WEB_ALLOWED_HOSTS=localhost:3100
AGRIINSIGHT_WEB_TRUST_FORWARDED_HEADERS=false
# Required when forwarded headers are trusted; the reverse proxy must strip caller values.
AGRIINSIGHT_WEB_TRUSTED_PROXY_KEY_BASE64=
AGRIINSIGHT_WEB_OIDC_ISSUER=http://localhost:8180/realms/agriinsight-demo
AGRIINSIGHT_WEB_OIDC_CLIENT_ID=agriinsight-web
AGRIINSIGHT_WEB_OIDC_CLIENT_SECRET=
AGRIINSIGHT_WEB_SESSION_DATABASE_URL=
AGRIINSIGHT_WEB_SESSION_ENCRYPTION_KEY_BASE64=
AGRIINSIGHT_WEB_TOKEN_KEY_ID=local-v1
# JSON object of prior key IDs to base64 keys, used only during a bounded rotation window.
AGRIINSIGHT_WEB_SESSION_PREVIOUS_KEYS_JSON={}
AGRIINSIGHT_WEB_CSRF_KEY_BASE64=
AGRIINSIGHT_WEB_SESSION_LIFETIME_SECONDS=28800
AGRIINSIGHT_BACKEND_BASE_URL=http://127.0.0.1:8080
AGRIINSIGHT_ANALYTICS_BASE_URL=http://127.0.0.1:8081

# One-shot migration process only; never expose to the web runtime.
AGRIINSIGHT_WEB_MIGRATOR_DATABASE_URL=
